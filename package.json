{
  "name": "overtex",
  "displayName": "Overtex",
  "description": "A complete LaTeX writing environment inside VS Code: build, live PDF preview and SyncTeX.",
  "version": "0.3.0",
  "publisher": "tansuasici",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#15171C",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "pdf",
    "synctex",
    "bibtex",
    "latexmk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tansuasici/Overtex"
  },
  "bugs": {
    "url": "https://github.com/tansuasici/Overtex/issues"
  },
  "homepage": "https://github.com/tansuasici/Overtex#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:bibtex",
    "workspaceContains:**/*.tex"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Building runs latexmk, which can execute code from a project's .latexmkrc, or a program or Docker image the settings name, so building and cleaning are disabled until the workspace is trusted, and the TexLab language server is not started. Viewing an existing PDF still works.",
      "restrictedConfigurations": [
        "overtex.latex.tool",
        "overtex.latex.latexmkPath",
        "overtex.tectonic.path",
        "overtex.docker.path",
        "overtex.docker.image",
        "overtex.latex.extraArgs",
        "overtex.synctex.path",
        "overtex.latexdiff.path",
        "overtex.texlab.path",
        "overtex.zotero.url"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overtex",
          "title": "Overtex",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "overtex": [
        {
          "id": "overtex.papers",
          "name": "Papers",
          "when": "overtex.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overtex.papers",
        "contents": "No papers yet. Papers are read from the .bib files in this workspace.\n[Add Paper](command:overtex.library.add)"
      }
    ],
    "commands": [
      {
        "command": "overtex.build",
        "title": "Build LaTeX Project",
        "category": "Overtex",
        "icon": "$(play)"
      },
      {
        "command": "overtex.cancelBuild",
        "title": "Cancel Build",
        "category": "Overtex"
      },
      {
        "command": "overtex.viewPdf",
        "title": "View PDF",
        "category": "Overtex",
        "icon": "$(open-preview)"
      },
      {
        "command": "overtex.forwardSearch",
        "title": "SyncTeX: Jump to PDF",
        "category": "Overtex"
      },
      {
        "command": "overtex.clean",
        "title": "Clean Auxiliary Files",
        "category": "Overtex"
      },
      {
        "command": "overtex.showLog",
        "title": "Show Build Log",
        "category": "Overtex"
      },
      {
        "command": "overtex.checkSetup",
        "title": "Check LaTeX Installation",
        "category": "Overtex"
      },
      {
        "command": "overtex.newDocument",
        "title": "New LaTeX Document",
        "category": "Overtex"
      },
      {
        "command": "overtex.gettingStarted",
        "title": "Getting Started",
        "category": "Overtex"
      },
      {
        "command": "overtex.addCitation",
        "title": "Add Citation from DOI or arXiv",
        "category": "Overtex"
      },
      {
        "command": "overtex.citeFromZotero",
        "title": "Cite from Zotero",
        "category": "Overtex"
      },
      {
        "command": "overtex.exportArxiv",
        "title": "Export for arXiv",
        "category": "Overtex"
      },
      {
        "command": "overtex.checkSubmission",
        "title": "Check Submission",
        "category": "Overtex"
      },
      {
        "command": "overtex.checkBibliography",
        "title": "Check Bibliography",
        "category": "Overtex"
      },
      {
        "command": "overtex.compareVersions",
        "title": "Compare Versions (latexdiff)",
        "category": "Overtex"
      },
      {
        "command": "overtex.countWords",
        "title": "Count Words",
        "category": "Overtex"
      },
      {
        "command": "overtex.viewer.toggleDarkMode",
        "title": "Toggle Dark PDF Preview",
        "category": "Overtex"
      },
      {
        "command": "overtex.library.add",
        "title": "Add Paper",
        "category": "Overtex",
        "icon": "$(add)"
      },
      {
        "command": "overtex.library.sort",
        "title": "Sort Papers",
        "category": "Overtex",
        "icon": "$(list-ordered)"
      },
      {
        "command": "overtex.library.refresh",
        "title": "Refresh Papers",
        "category": "Overtex",
        "icon": "$(refresh)"
      },
      {
        "command": "overtex.library.cite",
        "title": "Cite Paper",
        "category": "Overtex",
        "icon": "$(quote)"
      },
      {
        "command": "overtex.library.openPdf",
        "title": "Open Paper PDF",
        "category": "Overtex",
        "icon": "$(file-pdf)"
      },
      {
        "command": "overtex.library.downloadPdf",
        "title": "Download Paper PDF from arXiv",
        "category": "Overtex",
        "icon": "$(cloud-download)"
      },
      {
        "command": "overtex.library.openPage",
        "title": "Open Paper Page",
        "category": "Overtex",
        "icon": "$(link-external)"
      },
      {
        "command": "overtex.library.reveal",
        "title": "Show Paper in Bibliography",
        "category": "Overtex",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "overtex.build",
          "when": "editorLangId == latex",
          "group": "navigation@1"
        },
        {
          "command": "overtex.viewPdf",
          "when": "editorLangId == latex",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "overtex.library.add",
          "when": "view == overtex.papers",
          "group": "navigation@1"
        },
        {
          "command": "overtex.library.sort",
          "when": "view == overtex.papers",
          "group": "navigation@2"
        },
        {
          "command": "overtex.library.refresh",
          "when": "view == overtex.papers",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "overtex.library.cite",
          "when": "view == overtex.papers && viewItem =~ /paper/",
          "group": "inline@1"
        },
        {
          "command": "overtex.library.downloadPdf",
          "when": "view == overtex.papers && viewItem =~ /download/",
          "group": "inline@2"
        },
        {
          "command": "overtex.library.cite",
          "when": "view == overtex.papers && viewItem =~ /paper/",
          "group": "1_use@1"
        },
        {
          "command": "overtex.library.openPdf",
          "when": "view == overtex.papers && viewItem =~ /pdf/",
          "group": "1_use@2"
        },
        {
          "command": "overtex.library.downloadPdf",
          "when": "view == overtex.papers && viewItem =~ /download/",
          "group": "1_use@3"
        },
        {
          "command": "overtex.library.openPage",
          "when": "view == overtex.papers && viewItem =~ /web/",
          "group": "2_go@1"
        },
        {
          "command": "overtex.library.reveal",
          "when": "view == overtex.papers && viewItem =~ /paper/",
          "group": "2_go@2"
        }
      ],
      "commandPalette": [
        {
          "command": "overtex.library.sort",
          "when": "false"
        },
        {
          "command": "overtex.library.refresh",
          "when": "false"
        },
        {
          "command": "overtex.library.cite",
          "when": "false"
        },
        {
          "command": "overtex.library.openPdf",
          "when": "false"
        },
        {
          "command": "overtex.library.downloadPdf",
          "when": "false"
        },
        {
          "command": "overtex.library.openPage",
          "when": "false"
        },
        {
          "command": "overtex.library.reveal",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "overtex.build",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == latex"
      },
      {
        "command": "overtex.viewPdf",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == latex"
      },
      {
        "command": "overtex.forwardSearch",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == latex"
      }
    ],
    "configuration": {
      "title": "Overtex",
      "properties": {
        "overtex.latex.mainFile": {
          "type": "string",
          "default": "",
          "description": "Main .tex file, relative to the workspace root. Auto-detected when empty (`% !TEX root` comment, then `\\documentclass`)."
        },
        "overtex.latex.tool": {
          "type": "string",
          "enum": [
            "latexmk",
            "tectonic",
            "docker"
          ],
          "enumDescriptions": [
            "latexmk from a TeX distribution on this machine.",
            "Tectonic, which needs no TeX distribution and downloads the packages a document uses on first build. Always uses XeTeX. Export for arXiv and Check Submission are not available.",
            "latexmk inside a Docker image (overtex.docker.image), with the workspace folder mounted and the network off."
          ],
          "default": "latexmk",
          "description": "What builds the document."
        },
        "overtex.latex.engine": {
          "type": "string",
          "enum": [
            "pdflatex",
            "xelatex",
            "lualatex"
          ],
          "default": "pdflatex",
          "description": "TeX engine latexmk drives. BibTeX/Biber passes are run automatically. Tectonic ignores this and always uses XeTeX."
        },
        "overtex.latex.outDir": {
          "type": "string",
          "default": "",
          "description": "Output directory for build artifacts, relative to the main file. Empty means next to the main file."
        },
        "overtex.latex.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to latexmk, or to `tectonic -X compile` when building with Tectonic."
        },
        "overtex.latex.latexmkPath": {
          "type": "string",
          "default": "latexmk",
          "description": "Path to the latexmk executable."
        },
        "overtex.tectonic.path": {
          "type": "string",
          "default": "tectonic",
          "description": "Path to the Tectonic executable, used when overtex.latex.tool is tectonic."
        },
        "overtex.docker.path": {
          "type": "string",
          "default": "docker",
          "description": "Path to the Docker executable, used when overtex.latex.tool is docker."
        },
        "overtex.docker.image": {
          "type": "string",
          "default": "texlive/texlive:latest",
          "description": "Image to build in when overtex.latex.tool is docker. It must provide latexmk. Docker pulls it on first build; the default image takes about 9 GB of disk."
        },
        "overtex.synctex.path": {
          "type": "string",
          "default": "synctex",
          "description": "Path to the synctex executable."
        },
        "overtex.latexdiff.path": {
          "type": "string",
          "default": "latexdiff",
          "description": "Path to the latexdiff executable, used by Compare Versions."
        },
        "overtex.zotero.url": {
          "type": "string",
          "default": "http://127.0.0.1:23119",
          "description": "Where Cite from Zotero reaches Zotero's local server. Change it for Juris-M (port 24119), or in a remote window, where 127.0.0.1 is the remote machine."
        },
        "overtex.texlab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the TexLab language server for live diagnostics, completion (commands, environments, labels, citations), hover and go to definition. Needs `texlab` to be installed; skipped when the TexLab extension is installed."
        },
        "overtex.texlab.path": {
          "type": "string",
          "default": "texlab",
          "description": "Path to the texlab executable."
        },
        "overtex.texlab.chktex": {
          "type": "boolean",
          "default": false,
          "description": "Have TexLab run ChkTeX while you type and show its style warnings."
        },
        "overtex.build.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Build when a .tex or .bib file is saved."
        },
        "overtex.viewer.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the PDF preview after a successful build."
        },
        "overtex.viewer.colorScheme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "enumDescriptions": [
            "Show the PDF as it is.",
            "Invert the pages' brightness: light text on a dark page. Hues are kept, but images are inverted too.",
            "Dark pages with a dark or high contrast theme, light pages otherwise."
          ],
          "default": "light",
          "markdownDescription": "How the PDF preview draws pages. Only the preview changes; the PDF file is untouched. **Toggle Dark PDF Preview** and the preview's toolbar button switch between light and dark."
        },
        "overtex.wordCount.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the document's word count in the status bar, counted with `texcount` after each successful build. Needs `texcount`, which comes with TeX Live and MiKTeX."
        },
        "overtex.wordCount.goal": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Word target for the document, shown as `1,234 / 5,000 words` with progress in the tooltip. `0` means no goal."
        },
        "overtex.highlights.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Highlight `TODO`, `FIXME` and `XXX` comments and `\\todo{…}` notes, and dim text TeX skips: `\\iffalse … \\fi` and `comment` environments."
        },
        "overtex.mathPreview.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show math rendered with MathJax when hovering over `$…$`, `\\[…\\]`, `equation`, `align` and other math. Macros from `\\newcommand`, `\\DeclareMathOperator` and `\\def` in the file and the main file are used."
        },
        "overtex.mathPreview.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 4,
          "markdownDescription": "Size of the math hover preview."
        },
        "overtex.submission.pageLimit": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Page limit that **Check Submission** warns about. `0` means no limit; the page count is reported either way."
        },
        "overtex.submission.anonymous": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The paper goes to double-blind review: **Check Submission** also points at author names, affiliations, `\\thanks`, acknowledgments and `pdfauthor`."
        }
      }
    },
    "colors": [
      {
        "id": "overtex.todoBackground",
        "description": "Background of TODO, FIXME and XXX notes in LaTeX sources, also used for their scroll bar marks.",
        "defaults": {
          "dark": "#E5C07B40",
          "light": "#F2C94C66",
          "highContrast": "#E5C07B60",
          "highContrastLight": "#F2C94C80"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "overtex.gettingStarted",
        "title": "Get Started with Overtex",
        "description": "Install TeX, build your first document, and jump between the source and the PDF.",
        "featuredFor": [
          "**/*.tex"
        ],
        "steps": [
          {
            "id": "install",
            "title": "Install a TeX distribution",
            "description": "Overtex needs latexmk and a TeX engine from TeX Live, MacTeX or MiKTeX, or Tectonic or Docker through the overtex.latex.tool setting.\n[Check Installation](command:overtex.checkSetup)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:overtex.canBuild"
            ]
          },
          {
            "id": "document",
            "title": "Open or create a document",
            "description": "Open a folder with your .tex files, or start from a template.\n[New Document](command:overtex.newDocument)",
            "media": {
              "markdown": "media/walkthrough/document.md"
            },
            "completionEvents": [
              "onCommand:overtex.newDocument",
              "onLanguage:latex"
            ]
          },
          {
            "id": "build",
            "title": "Build the PDF",
            "description": "Saving builds the project. Errors go to the Problems panel.\n[Build Now](command:overtex.build)",
            "media": {
              "markdown": "media/walkthrough/build.md"
            },
            "completionEvents": [
              "onCommand:overtex.build"
            ]
          },
          {
            "id": "preview",
            "title": "Preview and SyncTeX",
            "description": "Jump from the cursor to the PDF, and Cmd/Ctrl+click the PDF to jump back.\n[Jump to PDF](command:overtex.forwardSearch)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:overtex.forwardSearch"
            ]
          },
          {
            "id": "texlab",
            "title": "Live checking with TexLab (optional)",
            "description": "Install TexLab for live diagnostics and completion.\n[Install TexLab](https://github.com/latex-lsp/texlab#installation)",
            "media": {
              "markdown": "media/walkthrough/texlab.md"
            },
            "completionEvents": [
              "onLink:https://github.com/latex-lsp/texlab#installation"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "vitest run",
    "test:e2e": "npm run build && esbuild test/e2e/suite.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out-e2e/suite.js --log-level=warning && node test/e2e/run.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "pdfjs-dist": "^6.5.438",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
