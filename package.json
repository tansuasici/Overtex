    "menus": {
      "editor/title": [
        {
          "command": "overtex.build",
          "when": "editorLangId == latex",
          "group": "navigation@1"
        },
        {
          "command": "overtex.viewPdf",
          "when": "editorLangId == latex",
          "group": "navigation@2"
        },
        {
          "command": "overtex.viewer.moveToNewWindow",
          "when": "activeWebviewPanelId == 'overtex.pdfPreview' && !isAuxiliaryWindow",
          "group": "navigation"
        },
        {
          "command": "overtex.viewer.present",
          "when": "activeWebviewPanelId == 'overtex.pdfPreview'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "overtex.library.add",
          "when": "view == overtex.papers",
          "group": "navigation@1"
        },
        {
          "command": "overtex.library.sort",
          "when": "view == overtex.papers",
          "group": "navigation@2"
        },
        {
          "command": "overtex.library.refresh",
          "when": "view == overtex.papers",
          "group": "navigation@3"
        },
        {
          "command": "overtex.labels.refresh",
          "when": "view == overtex.labels",
          "group": "navigation@1"
        },
        {
          "command": "overtex.history.snapshot",
          "when": "view == overtex.history",
          "group": "navigation@1"
        },
        {
          "command": "overtex.history.refresh",
          "when": "view == overtex.history",
          "group": "navigation@2"
        },
        {
          "command": "overtex.notes.add",
          "when": "view == overtex.sourceNotes",
          "group": "navigation@1"
        },
        {
          "command": "overtex.todos.refresh",
          "when": "view == overtex.todos",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "overtex.library.cite",
          "when": "view == overtex.papers && viewItem =~ /paper/",
          "group": "inline@1"
        },
        {
          "command": "overtex.library.downloadPdf",
          "when": "view == overtex.papers && viewItem =~ /download/",
          "group": "inline@2"
        },
        {
          "command": "overtex.library.cite",
          "when": "view == overtex.papers && viewItem =~ /paper/",
          "group": "1_use@1"
        },
        {
          "command": "overtex.library.openPdf",
          "when": "view == overtex.papers && viewItem =~ /pdf/",
          "group": "1_use@2"
        },
        {
          "command": "overtex.library.downloadPdf",
          "when": "view == overtex.papers && viewItem =~ /download/",
          "group": "1_use@3"
        },
        {
          "command": "overtex.library.openPage",
          "when": "view == overtex.papers && viewItem =~ /web/",
          "group": "2_go@1"
        },
        {
          "command": "overtex.library.reveal",
          "when": "view == overtex.papers && viewItem =~ /paper/",
          "group": "2_go@2"
        },
        {
          "command": "overtex.labels.insertRef",
          "when": "view == overtex.labels && viewItem =~ /hasDefinition/",
          "group": "inline@1"
        },
        {
          "command": "overtex.labels.rename",
          "when": "view == overtex.labels && viewItem =~ /label/",
          "group": "inline@2"
        },
        {
          "command": "overtex.labels.insertRef",
          "when": "view == overtex.labels && viewItem =~ /hasDefinition/",
          "group": "1_use@1"
        },
        {
          "command": "overtex.labels.rename",
          "when": "view == overtex.labels && viewItem =~ /label/",
          "group": "1_use@2"
        },
        {
          "command": "overtex.history.openPdf",
          "when": "view == overtex.history && viewItem =~ /snapshotWithPdf/",
          "group": "inline@1"
        },
        {
          "command": "overtex.history.compare",
          "when": "view == overtex.history && viewItem =~ /^snapshot( |$)/",
          "group": "inline@2"
        },
        {
          "command": "overtex.history.openPdf",
          "when": "view == overtex.history && viewItem =~ /snapshotWithPdf/",
          "group": "1_use@1"
        },
        {
          "command": "overtex.history.compare",
          "when": "view == overtex.history && viewItem =~ /^snapshot( |$)/",
          "group": "1_use@2"
        },
        {
          "command": "overtex.history.label",
          "when": "view == overtex.history && viewItem =~ /^snapshot( |$)/",
          "group": "2_edit@1"
        },
        {
          "command": "overtex.history.delete",
          "when": "view == overtex.history && viewItem =~ /^snapshot( |$)/",
          "group": "2_edit@2"
        },
        {
          "command": "overtex.history.restoreFile",
          "when": "view == overtex.history && viewItem == snapshotFile",
          "group": "inline"
        },
        {
          "command": "overtex.history.openFile",
          "when": "view == overtex.history && viewItem == snapshotFile",
          "group": "1_use@1"
        },
        {
          "command": "overtex.history.restoreFile",
          "when": "view == overtex.history && viewItem == snapshotFile",
          "group": "1_use@2"
        },
        {
          "command": "overtex.notes.resolve",
          "when": "view == overtex.sourceNotes && viewItem == note.open",
          "group": "inline@1"
        },
        {
          "command": "overtex.notes.reopen",
          "when": "view == overtex.sourceNotes && viewItem == note.resolved",
          "group": "inline@1"
        },
        {
          "command": "overtex.notes.attachToSelection",
          "when": "view == overtex.sourceNotes && viewItem =~ /^note\\./",
          "group": "inline@2"
        },
        {
          "command": "overtex.notes.deleteThread",
          "when": "view == overtex.sourceNotes && viewItem =~ /^note\\./",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "overtex.library.sort",
          "when": "false"
        },
        {
          "command": "overtex.library.refresh",
          "when": "false"
        },
        {
          "command": "overtex.library.cite",
          "when": "false"
        },
        {
          "command": "overtex.library.openPdf",
          "when": "false"
        },
        {
          "command": "overtex.library.downloadPdf",
          "when": "false"
        },
        {
          "command": "overtex.library.openPage",
          "when": "false"
        },
        {
          "command": "overtex.library.reveal",
          "when": "false"
        },
        {
          "command": "overtex.labels.refresh",
          "when": "false"
        },
        {
          "command": "overtex.labels.rename",
          "when": "false"
        },
        {
          "command": "overtex.labels.insertRef",
          "when": "false"
        },
        {
          "command": "overtex.history.refresh",
          "when": "false"
        },
        {
          "command": "overtex.history.openFile",
          "when": "false"
        },
        {
          "command": "overtex.history.restoreFile",
          "when": "false"
        },
        {
          "command": "overtex.notes.create",
          "when": "false"
        },
        {
          "command": "overtex.notes.reply",
          "when": "false"
        },
        {
          "command": "overtex.notes.cancel",
          "when": "false"
        },
        {
          "command": "overtex.notes.resolve",
          "when": "false"
        },
        {
          "command": "overtex.notes.reopen",
          "when": "false"
        },
        {
          "command": "overtex.notes.deleteThread",
          "when": "false"
        },
        {
          "command": "overtex.notes.deleteComment",
          "when": "false"
        },
        {
          "command": "overtex.notes.attachToSelection",
          "when": "false"
        },
        {
          "command": "overtex.notes.open",
          "when": "false"
        },
        {
          "command": "overtex.todos.refresh",
          "when": "false"
        },
        {
          "command": "overtex.notes.add",
          "when": "editorLangId == latex || editorLangId == tex"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "overtex.notes.create",
          "group": "inline@1",
          "when": "commentController == overtex.notes && commentThreadIsEmpty"
        },
        {
          "command": "overtex.notes.cancel",
          "group": "inline@2",
          "when": "commentController == overtex.notes && commentThreadIsEmpty"
        },
        {
          "command": "overtex.notes.reply",
          "group": "inline@1",
          "when": "commentController == overtex.notes && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "overtex.notes.resolve",
          "group": "inline@1",
          "when": "commentController == overtex.notes && commentThread == overtex.note.open"
        },
        {
          "command": "overtex.notes.reopen",
          "group": "inline@1",
          "when": "commentController == overtex.notes && commentThread == overtex.note.resolved"
        },
        {
          "command": "overtex.notes.deleteThread",
          "group": "inline@2",
          "when": "commentController == overtex.notes && commentThread =~ /^overtex\\.note\\./"
        }
      ],
      "comments/comment/title": [
        {
          "command": "overtex.notes.deleteComment",
          "group": "inline@1",
          "when": "commentController == overtex.notes && comment == overtex.noteComment"
        }
      ]
    },
    "keybindings": [
      {
        "command": "overtex.build",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == latex"
      },
      {
        "command": "overtex.viewPdf",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == latex"
      },
      {
        "command": "overtex.forwardSearch",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == latex"
      }
    ],
    "configuration": {
      "title": "Overtex",
      "properties": {
        "overtex.latex.mainFile": {
          "type": "string",
          "default": "",
          "description": "Main .tex file, relative to the workspace root. Auto-detected when empty (`% !TEX root` comment, then `\\documentclass`)."
        },
        "overtex.latex.tool": {
          "type": "string",
          "enum": [
            "latexmk",
            "tectonic",
            "docker"
          ],
          "enumDescriptions": [
            "latexmk from a TeX distribution on this machine.",
            "Tectonic, which needs no TeX distribution and downloads the packages a document uses on first build. Always uses XeTeX. Export for arXiv and Check Submission are not available.",
            "latexmk inside a Docker image (overtex.docker.image), with the workspace folder mounted and the network off."
          ],
          "default": "latexmk",
          "description": "What builds the document."
        },
        "overtex.latex.engine": {
          "type": "string",
          "enum": [
            "pdflatex",
            "xelatex",
            "lualatex"
          ],
          "default": "pdflatex",
          "description": "TeX engine latexmk drives. BibTeX/Biber passes are run automatically. Tectonic ignores this and always uses XeTeX."
        },
        "overtex.latex.outDir": {
          "type": "string",
          "default": "",
          "description": "Output directory for build artifacts, relative to the main file. Empty means next to the main file."
        },
        "overtex.latex.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to latexmk, or to `tectonic -X compile` when building with Tectonic."
        },
        "overtex.latex.latexmkPath": {
          "type": "string",
          "default": "latexmk",
          "description": "Path to the latexmk executable."
        },
        "overtex.tectonic.path": {
          "type": "string",
          "default": "tectonic",
          "description": "Path to the Tectonic executable, used when overtex.latex.tool is tectonic."
        },
        "overtex.docker.path": {
          "type": "string",
          "default": "docker",
          "description": "Path to the Docker executable, used when overtex.latex.tool is docker."
        },
        "overtex.docker.image": {
          "type": "string",
          "default": "texlive/texlive:latest",
          "description": "Image to build in when overtex.latex.tool is docker. It must provide latexmk. Docker pulls it on first build; the default image takes about 9 GB of disk."
        },
        "overtex.synctex.path": {
          "type": "string",
          "default": "synctex",
          "description": "Path to the synctex executable."
        },
        "overtex.latexdiff.path": {
          "type": "string",
          "default": "latexdiff",
          "description": "Path to the latexdiff executable, used by Compare Versions."
        },
        "overtex.zotero.url": {
          "type": "string",
          "default": "http://127.0.0.1:23119",
          "description": "Where Cite from Zotero reaches Zotero's local server. Change it for Juris-M (port 24119), or in a remote window, where 127.0.0.1 is the remote machine."
        },
        "overtex.texlab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the TexLab language server for live diagnostics, completion (commands, environments, labels, citations), hover and go to definition. Needs `texlab` to be installed; skipped when the TexLab extension is installed."
        },
        "overtex.texlab.path": {
          "type": "string",
          "default": "texlab",
          "description": "Path to the texlab executable."
        },
        "overtex.texlab.chktex": {
          "type": "boolean",
          "default": false,
          "description": "Have TexLab run ChkTeX while you type and show its style warnings."
        },
        "overtex.build.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Build when a .tex or .bib file is saved."
        },
        "overtex.build.stallTimeout": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Stop a build that prints nothing for this many seconds, or keeps printing the same lines, and say why. 0 turns this off."
        },
        "overtex.viewer.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the PDF preview after a successful build."
        },
        "overtex.viewer.colorScheme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "enumDescriptions": [
            "Show the PDF as it is.",
            "Invert the pages' brightness: light text on a dark page. Hues are kept, but images are inverted too.",
            "Dark pages with a dark or high contrast theme, light pages otherwise."
          ],
          "default": "light",
          "markdownDescription": "How the PDF preview draws pages. Only the preview changes; the PDF file is untouched. **Toggle Dark PDF Preview** and the preview's toolbar button switch between light and dark."
        },
        "overtex.grammar.engine": {
          "type": "string",
          "enum": [
            "harper",
            "languagetool",
            "off"
          ],
          "enumDescriptions": [
            "Harper, built into Overtex: English only, nothing to install, and the text never leaves the machine.",
            "A LanguageTool server at overtex.grammar.url: many languages, but the server must be installed or reachable.",
            "No spelling or grammar check."
          ],
          "default": "harper",
          "markdownDescription": "What Check Spelling and Grammar uses. `harper` checks English inside Overtex with nothing to install; `languagetool` sends the text to the server at `#overtex.grammar.url#` and checks other languages too; `off` turns the check off. The dictionary is shared by both."
        },
        "overtex.grammar.url": {
          "type": "string",
          "default": "http://localhost:8081",
          "markdownDescription": "Where Check Spelling and Grammar reaches a LanguageTool server. The default is a local one (`brew services start languagetool` listens on 8081). The text of the file being checked is sent to this address, so it leaves the machine only if you point it at a remote server."
        },
        "overtex.grammar.language": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Language code for checks, such as `en-US`, `en-GB` or `de-DE`. `auto` takes it from babel, polyglossia or the class options, in the file or in the main file, and checks American English when the document names none. Harper checks English only (American, British, Australian, Canadian and Indian spelling); LanguageTool checks many languages, though not Turkish."
        },
        "overtex.grammar.checkOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Check spelling and grammar each time a LaTeX file is saved."
        },
        "overtex.grammar.dictionary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Words the spelling and grammar check does not report as misspelled."
        },
        "overtex.grammar.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Rules to leave out: Harper rule names such as `LongSentences`, or LanguageTool rule IDs such as `EN_QUOTES`. Each checker ignores the other's names. The quick fix on a finding adds its rule here."
        },
        "overtex.wordCount.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the document's word count in the status bar, counted with `texcount` after each successful build. Needs `texcount`, which comes with TeX Live and MiKTeX."
        },
        "overtex.wordCount.goal": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Word target for the document, shown as `1,234 / 5,000 words` with progress in the tooltip. `0` means no goal."
        },
        "overtex.history.maxSnapshots": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "markdownDescription": "How many snapshots the History panel keeps per document; older ones are removed, except named ones. Overtex takes a snapshot of the `.tex`, `.bib`, `.sty`, `.cls` and `.bst` files after each successful build in which they changed. `0` turns history off."
        },
        "overtex.history.keepPdf": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep each build's PDF with its snapshot, so that **Open Snapshot PDF** shows the document as it was. A PDF is stored once however many snapshots share it."
        },
        "overtex.highlights.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Highlight `TODO`, `FIXME` and `XXX` comments and `\\todo{…}` notes, and dim text TeX skips: `\\iffalse … \\fi` and `comment` environments."
        },
        "overtex.mathPreview.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show math rendered with MathJax when hovering over `$…$`, `\\[…\\]`, `equation`, `align` and other math. Macros from `\\newcommand`, `\\DeclareMathOperator` and `\\def` in the file and the main file are used."
        },
        "overtex.mathPreview.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 4,
          "markdownDescription": "Size of the math hover preview."
        },
        "overtex.submission.pageLimit": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Page limit that **Check Submission** warns about. `0` means no limit; the page count is reported either way."
        },
        "overtex.submission.anonymous": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The paper goes to double-blind review: **Check Submission** also points at author names, affiliations, `\\thanks`, acknowledgments and `pdfauthor`."
        }
      }
    },
    "colors": [
      {
        "id": "overtex.todoBackground",
        "description": "Background of TODO, FIXME and XXX notes in LaTeX sources, also used for their scroll bar marks.",
        "defaults": {
          "dark": "#E5C07B40",
          "light": "#F2C94C66",
          "highContrast": "#E5C07B60",
          "highContrastLight": "#F2C94C80"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "overtex.gettingStarted",
        "title": "Get Started with Overtex",
        "description": "Install TeX, build your first document, and jump between the source and the PDF.",
        "featuredFor": [
          "**/*.tex"
        ],
        "steps": [
          {
            "id": "install",
            "title": "Install a TeX distribution",
            "description": "Overtex needs latexmk and a TeX engine from TeX Live, MacTeX or MiKTeX, or Tectonic or Docker through the overtex.latex.tool setting.\n[Check Installation](command:overtex.checkSetup)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:overtex.canBuild"
            ]
          },
          {
            "id": "document",
            "title": "Open or create a document",
            "description": "Open a folder with your .tex files, or start from a template.\n[New Document](command:overtex.newDocument)",
            "media": {
              "markdown": "media/walkthrough/document.md"
            },
            "completionEvents": [
              "onCommand:overtex.newDocument",
              "onLanguage:latex"
            ]
          },
          {
            "id": "build",
            "title": "Build the PDF",
            "description": "Saving builds the project. Errors go to the Problems panel.\n[Build Now](command:overtex.build)",
            "media": {
              "markdown": "media/walkthrough/build.md"
            },
            "completionEvents": [
              "onCommand:overtex.build"
            ]
          },
          {
            "id": "preview",
            "title": "Preview and SyncTeX",
            "description": "Jump from the cursor to the PDF, and Cmd/Ctrl+click the PDF to jump back.\n[Jump to PDF](command:overtex.forwardSearch)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:overtex.forwardSearch"
            ]
          },
          {
            "id": "texlab",
            "title": "Live checking with TexLab (optional)",
            "description": "Install TexLab for live diagnostics and completion.\n[Install TexLab](https://github.com/latex-lsp/texlab#installation)",
            "media": {
              "markdown": "media/walkthrough/texlab.md"
            },
            "completionEvents": [
              "onLink:https://github.com/latex-lsp/texlab#installation"
            ]
          },
          {
            "id": "overleaf",
            "title": "Work with Overleaf (optional)",
            "description": "Overtex does not need Overleaf. To sync an Overleaf project, add the separate Overleaf Connect extension.\n[Get Overleaf Connect](https://marketplace.visualstudio.com/items?itemName=tansuasici.overleaf-connect)",
            "media": {
              "markdown": "media/walkthrough/overleaf.md"
            },
            "completionEvents": [
              "onLink:https://marketplace.visualstudio.com/items?itemName=tansuasici.overleaf-connect"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "vitest run",
    "test:e2e": "npm run build && esbuild test/e2e/suite.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out-e2e/suite.js --log-level=warning && node test/e2e/run.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "harper.js": "3.0.0",
    "pdfjs-dist": "^6.5.438",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
