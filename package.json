{
  "name": "overtex",
  "displayName": "Overtex",
  "description": "A complete LaTeX writing environment inside VS Code: build, live PDF preview and SyncTeX.",
  "version": "0.8.0",
  "publisher": "tansuasici",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#15171C",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "pdf",
    "synctex",
    "bibtex",
    "latexmk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tansuasici/Overtex"
  },
  "bugs": {
    "url": "https://github.com/tansuasici/Overtex/issues"
  },
  "homepage": "https://github.com/tansuasici/Overtex#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:bibtex",
    "workspaceContains:**/*.tex",
    "onWebviewPanel:overtex.pdfPreview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Building runs latexmk, which can execute code from a project's .latexmkrc, or a program or Docker image the settings name, so building and cleaning are disabled until the workspace is trusted, and the TexLab language server is not started. Viewing an existing PDF still works.",
      "restrictedConfigurations": [
        "overtex.latex.tool",
        "overtex.latex.latexmkPath",
        "overtex.tectonic.path",
        "overtex.docker.path",
        "overtex.docker.image",
        "overtex.latex.extraArgs",
        "overtex.synctex.path",
        "overtex.latexdiff.path",
        "overtex.texlab.path",
        "overtex.zotero.url",
        "overtex.grammar.url"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overtex",
          "title": "Overtex",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "overtex": [
        {
          "id": "overtex.papers",
          "name": "Papers",
          "when": "overtex.active"
        },
        {
          "id": "overtex.labels",
          "name": "Labels",
          "when": "overtex.active"
        },
        {
          "id": "overtex.history",
          "name": "History",
          "when": "overtex.active"
        },
        {
          "id": "overtex.sourceNotes",
          "name": "Notes",
          "when": "overtex.active"
        },
        {
          "id": "overtex.todos",
          "name": "To-dos",
          "when": "overtex.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overtex.papers",
        "contents": "No papers yet. Papers are read from the .bib files in this workspace.\n[Add Paper](command:overtex.library.add)"
      },
      {
        "view": "overtex.labels",
        "contents": "No labels yet. Labels and references are read from the .tex files in this workspace."
      },
      {
        "view": "overtex.history",
        "contents": "No snapshots yet. Overtex keeps a snapshot of the sources and the PDF after each successful build.\n[Save Snapshot](command:overtex.history.snapshot)"
      },
      {
        "view": "overtex.sourceNotes",
        "contents": "No notes yet. Click the + beside a line of a .tex file, or select text and run Add Note, to leave a note for your co-authors. Notes are saved in .overtex/notes.json, so commit that file to share them.\n[Add Note](command:overtex.notes.add)"
      },
      {
        "view": "overtex.todos",
        "contents": "No \\todo or \\fixme notes in the .tex files of this workspace."
      }
    ],
    "commands": [
      {
        "command": "overtex.build",
        "title": "Build LaTeX Project",
        "category": "Overtex",
        "icon": "$(play)"
      },
      {
        "command": "overtex.cancelBuild",
        "title": "Cancel Build",
        "category": "Overtex"
      },
      {
        "command": "overtex.viewPdf",
